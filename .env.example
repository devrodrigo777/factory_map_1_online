# =====================================================================
# Variáveis de Ambiente - Mapa da Fábrica (Produção / Coolify VPS)
# =====================================================================

# Porta do container
PORT=3000

# Ambiente
NODE_ENV=production

# Diretório persistente do banco SQLite e arquivos de upload
DATA_DIR=/app/server/data

# Chave secreta de aplicação para assinatura de sessões e Captchas
# (se omitido, o sistema gera e salva automaticamente em server/data/app_secret.key)
APP_SECRET=gere_uma_chave_aleatoria_longa_aqui_com_letras_e_numeros
